# Copy this file to .env and fill it in.

# --- Claude (https://platform.claude.com -> API keys) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low = fastest replies on the phone; medium = more careful
AI_EFFORT=low
# claude (default when a key is set) or rules (keyword fallback, no AI, English replies)
AI_MODE=

# --- Server ---
PORT=3000
# Public HTTPS address Twilio reaches, e.g. your ngrok URL (no trailing slash)
PUBLIC_URL=https://xxxx.ngrok-free.app
# Optional: protects /api/* and the dashboard (?token=...) when the server is public
API_TOKEN=

# --- Twilio ---
# Used to check that webhook requests really come from Twilio. Leave empty to skip the check.
TWILIO_AUTH_TOKEN=
# Optional comma-separated list of phone numbers (E.164, e.g. +919876543210) allowed to control the pump
ALLOWED_CALLERS=

# --- ESP32 link ---
# true = built-in simulated ESP32 (no hardware, no broker). false = real ESP32 over MQTT.
SIMULATOR=true
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=solarirrigation
# Make this unique (it must match DEVICE_ID in the firmware's config.h), e.g. farm-ravi-7k3q
DEVICE_ID=farm1
ACK_TIMEOUT_MS=8000
# Longest voice/SMS run (match MAX_RUN_MINUTES in the firmware's config.h) and the run time when none is given
MAX_RUN_MINUTES=60
DEFAULT_RUN_MINUTES=20

# --- Weather (Open-Meteo, free, no key) ---
# Farm location. When set, the assistant can answer forecast questions and the ESP32's auto mode
# skips watering when rain is expected (weather never starts the pump).
FARM_LAT=
FARM_LON=
RAIN_SKIP_PROBABILITY=60
RAIN_SKIP_MM=5
